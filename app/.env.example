# Firebase 설정 템플릿
# 1) 이 파일을 복사해서 같은 폴더에 `.env.local` 로 저장
# 2) Firebase 콘솔 > 프로젝트 설정 > 내 앱 > firebaseConfig 값을 채워 넣기
# `.env.local` 은 .gitignore(*.local)에 걸려 GitHub에 올라가지 않음

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 알림용: 콘솔 > 프로젝트 설정 > 클라우드 메시징 > 웹 푸시 인증서 > 키 쌍
VITE_FIREBASE_VAPID_KEY=

# true 로 바꾸면 실제 DB 대신 로컬 Firebase Emulator에 연결
VITE_USE_EMULATOR=false
